# Normalize text files to LF in the repository; checkouts use the platform default.
* text=auto

# Must stay LF even on Windows, or the Linux toolchain breaks.
gradlew text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Windows scripts
*.bat text eol=crlf

*.jar binary
*.aar binary
*.apk binary
*.zip binary
*.png binary
*.keystore binary
*.sound binary
